+func TestAndroidTrafficRatesResetAndRecover(t *testing.T) {
+	var meter androidTrafficMeter
+	now := time.Now()
+	process := new(xray.Process)
+	up := "outbound>>>direct>>>traffic>>>uplink"
+	down := "outbound>>>direct>>>traffic>>>downlink"
+	if got := meter.sample(process, map[string]int64{up: 100, down: 300}, now); got.State != "waiting" {
+		t.Fatalf("first sample = %+v", got)
+	}
+	got := meter.sample(process, map[string]int64{up: 2100, down: 6300}, now.Add(2*time.Second))
+	if got.State != "ready" || got.Upload != 1000 || got.Download != 3000 {
+		t.Fatalf("two-second rates = %+v", got)
+	}
+	if got := meter.sample(process, map[string]int64{up: 0, down: 0}, now.Add(3*time.Second)); got.State != "waiting" {
+		t.Fatalf("reset must rebaseline: %+v", got)
+	}
+	if got := meter.sample(process, map[string]int64{up: 0, down: 0}, now.Add(4*time.Second)); got.State != "ready" || got.Upload != 0 || got.Download != 0 {
+		t.Fatalf("idle must report zero: %+v", got)
+	}
+	if got := meter.sample(new(xray.Process), map[string]int64{up: 99999}, now.Add(5*time.Second)); got.State != "waiting" {
+		t.Fatalf("new process must rebaseline: %+v", got)
+	}
+}
