+func TestAndroidTrafficPolicyKeepsTemplateOptions(t *testing.T) {
+	c := &xray.Config{Policy: json_util.RawMessage(`{"levels":{"0":{"connIdle":123}},"system":{"statsOutboundUplink":false,"statsInboundUplink":true}}`)}
+	if err := enableAndroidOutboundStats(c); err != nil {
+		t.Fatal(err)
+	}
+	var policy map[string]any
+	if err := json.Unmarshal(c.Policy, &policy); err != nil {
+		t.Fatal(err)
+	}
+	system := policy["system"].(map[string]any)
+	if system["statsOutboundUplink"] != true || system["statsOutboundDownlink"] != true || system["statsInboundUplink"] != true || string(c.Stats) != "{}" {
+		t.Fatalf("missing outbound stats: %s", c.Policy)
+	}
+	if policy["levels"].(map[string]any)["0"].(map[string]any)["connIdle"] != float64(123) {
+		t.Fatalf("existing level was changed: %s", c.Policy)
+	}
+}
