+func TestAndroidMetricDenialBackoffPreservesTransientRetry(t *testing.T) {
+	cache := androidSamplingCache{}
+	calls := 0
+	denied := func() (int, error) { calls++; return 0, fmt.Errorf("read /proc: %w", os.ErrPermission) }
+	_, err := sampleAndroidMetric(&cache, "android", "tcp", denied)
+	if !errors.Is(err, os.ErrPermission) {
+		t.Fatalf("first denial = %v", err)
+	}
+	for i := 0; i < 100; i++ {
+		_, err = sampleAndroidMetric(&cache, "android", "tcp", denied)
+		if !errors.Is(err, errSamplingDeferred) {
+			t.Fatalf("deferred denial = %v", err)
+		}
+	}
+	if calls != 1 {
+		t.Fatalf("denied metric calls = %d, want 1", calls)
+	}
+	cache.denied["tcp"] = time.Time{}
+	value, err := sampleAndroidMetric(&cache, "android", "tcp", func() (int, error) { return 42, nil })
+	if value != 42 || err != nil {
+		t.Fatalf("permission recovery = %d, %v", value, err)
+	}
+	transient := errors.New("temporary sample failure")
+	for i := 0; i < 2; i++ {
+		_, err = sampleAndroidMetric(&cache, "android", "tcp", func() (int, error) { calls++; return 0, transient })
+		if !errors.Is(err, transient) {
+			t.Fatalf("transient error = %v", err)
+		}
+	}
+	if calls != 3 {
+		t.Fatalf("transient calls = %d, want 3 total", calls)
+	}
+	for i := 0; i < 2; i++ {
+		sampleAndroidMetric(&cache, "linux", "tcp", denied)
+	}
+	if calls != 5 {
+		t.Fatalf("non-Android calls = %d, want 5 total", calls)
+	}
+}
