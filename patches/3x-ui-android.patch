@@ -0,0 +1,135 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/util/json_util"
+	"github.com/mhsanaei/3x-ui/v3/internal/xray"
+)
+
+func TestAndroidTrafficSequenceSurvivesSamplerRestart(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "traffic.json")
+	start := func() context.CancelFunc {
+		ctx, cancel := context.WithCancel(context.Background())
+		done := make(chan struct{})
+		go func() {
+			defer close(done)
+			runAndroidTraffic(ctx, file, "same-session")
+		}()
+		stop := func() { cancel(); <-done }
+		t.Cleanup(stop)
+		return stop
+	}
+	read := func(after int64) androidTrafficSnapshot {
+		t.Helper()
+		deadline := time.Now().Add(4 * time.Second)
+		for time.Now().Before(deadline) {
+			data, err := os.ReadFile(file)
+			var snapshot androidTrafficSnapshot
+			if err == nil && json.Unmarshal(data, &snapshot) == nil && snapshot.Sequence > 0 && snapshot.Sequence != after {
+				return snapshot
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+		t.Fatalf("sampler did not advance beyond sequence %d", after)
+		return androidTrafficSnapshot{}
+	}
+	stop := start()
+	before := read(0)
+	before = read(before.Sequence)
+	stop()
+	start()
+	after := read(before.Sequence)
+	if after.Session != before.Session || after.Sequence != before.Sequence+1 {
+		t.Fatalf("restarted sampler = %+v; previous = %+v", after, before)
+	}
+}
