+func TestPublicIPCachePersistsUntilNewService(t *testing.T) {
+	var requests atomic.Int32
+	var failing atomic.Bool
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		if failing.Load() {
+			w.WriteHeader(http.StatusServiceUnavailable)
+			return
+		}
+		if r.URL.Path == "/4" {
+			fmt.Fprintln(w, "203.0.113.8")
+		} else {
+			fmt.Fprintln(w, "2001:db8::8")
+		}
+	}))
+	defer server.Close()
+	setPublicIPTestServices(t, []string{server.URL + "/4"}, []string{server.URL + "/6"})
+	cache := publicIPCache{}
+	ipv4, ipv6 := cache.load(true)
+	if ipv4 != "203.0.113.8" || ipv6 != "2001:db8::8" {
+		t.Fatalf("resolved addresses = %q, %q", ipv4, ipv6)
+	}
+	for i := 0; i < 10; i++ {
+		cache.snapshot()
+	}
+	if got := requests.Load(); got != 2 {
+		t.Fatalf("cached requests = %d, want 2", got)
+	}
+	failing.Store(true)
+	ipv4, ipv6 = cache.load(true)
+	if ipv4 != "203.0.113.8" || ipv6 != "2001:db8::8" {
+		t.Fatalf("cached addresses changed during same service lifetime: %q, %q", ipv4, ipv6)
+	}
+	if got := requests.Load(); got != 2 {
+		t.Fatalf("successful cache retried: %d requests, want 2", got)
+	}
+	failedCache := publicIPCache{}
+	ipv4, ipv6 = failedCache.load(true)
+	if ipv4 != "N/A" || ipv6 != "N/A" {
+		t.Fatalf("failed addresses = %q, %q", ipv4, ipv6)
+	}
+	failing.Store(false)
+	for i := 0; i < 100; i++ {
+		ipv4, ipv6 = failedCache.load(true)
+		if ipv4 != "N/A" || ipv6 != "N/A" {
+			t.Fatalf("failed cache changed during same service lifetime: %q, %q", ipv4, ipv6)
+		}
+	}
+	if got := requests.Load(); got != 4 {
+		t.Fatalf("failed cache retried: %d requests, want 4 total", got)
+	}
+	restartedCache := publicIPCache{}
+	ipv4, ipv6 = restartedCache.load(true)
+	if ipv4 != "203.0.113.8" || ipv6 != "2001:db8::8" {
+		t.Fatalf("new service failed to resolve: %q, %q", ipv4, ipv6)
+	}
+	if got := requests.Load(); got != 6 {
+		t.Fatalf("new service requests = %d, want 6 total", got)
+	}
+}
