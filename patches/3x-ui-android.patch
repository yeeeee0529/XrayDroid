@@ -0,0 +1,27 @@
+package service
+
+import (
+	"testing"
+
+	"github.com/shirou/gopsutil/v4/disk"
+)
+
+func TestDiskUsagePath(t *testing.T) {
+	directory := t.TempDir()
+	t.Setenv("XUI_DB_FOLDER", directory)
+	if got := diskUsagePath("android"); got != directory {
+		t.Fatalf("Android disk path = %q, want %q", got, directory)
+	}
+	info, err := disk.Usage(diskUsagePath("android"))
+	if err != nil {
+		t.Fatalf("Query app data filesystem: %v", err)
+	}
+	if info.Total == 0 {
+		t.Fatal("App data filesystem must report a nonzero capacity")
+	}
+	for _, platform := range []string{"linux", "darwin", "windows"} {
+		if got := diskUsagePath(platform); got != "/" {
+			t.Errorf("%s disk path = %q, want root", platform, got)
+		}
+	}
+}
diff --git a/internal/web/service/server_sampling.go b/internal/web/service/server_sampling.go
new file mode 100644
index 0000000..a095098
--- /dev/null
+++ b/internal/web/service/server_sampling.go
@@ -0,0 +1,190 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/shirou/gopsutil/v4/cpu"
+	"github.com/shirou/gopsutil/v4/disk"
+)
+
+const publicIPTimeout = 3 * time.Second
+
+type publicIPCache struct {
+	mu         sync.Mutex
+	ipv4, ipv6 string
+	resolved   bool
+	pending    chan struct{}
+}
+
+func (c *publicIPCache) snapshot() (string, string) {
+	return c.load(false)
+}
+
+func (c *publicIPCache) load(wait bool) (string, string) {
+	c.mu.Lock()
+	if c.pending == nil && !c.resolved {
+		c.pending = make(chan struct{})
+		go c.refresh(c.pending, http.DefaultClient, publicIPv4Services, publicIPv6Services, publicIPTimeout)
+	}
+	pending := c.pending
+	if wait && pending != nil {
+		c.mu.Unlock()
+		<-pending
+		c.mu.Lock()
+	}
+	defer c.mu.Unlock()
+	ipv4, ipv6 := c.ipv4, c.ipv6
+	if ipv4 == "" {
+		ipv4 = "N/A"
+	}
+	if ipv6 == "" {
+		ipv6 = "N/A"
+	}
+	return ipv4, ipv6
+}
+
+// 每個服務實例只查詢一次；兩個位址族群共用期限，最多同時送出兩個請求。
+func (c *publicIPCache) refresh(done chan struct{}, client *http.Client, ipv4Services, ipv6Services []string, timeout time.Duration) {
+	ctx, cancel := context.WithTimeout(context.Background(), timeout)
+	defer cancel()
+	var ipv4, ipv6 string
+	var workers sync.WaitGroup
+	workers.Add(2)
+	go func() { defer workers.Done(); ipv4 = resolvePublicIP(ctx, client, ipv4Services, false) }()
+	go func() { defer workers.Done(); ipv6 = resolvePublicIP(ctx, client, ipv6Services, true) }()
+	workers.Wait()
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.ipv4, c.ipv6 = ipv4, ipv6
+	c.resolved = true
+	c.pending = nil
+	close(done)
+}
+
+func resolvePublicIP(ctx context.Context, client *http.Client, services []string, ipv6 bool) string {
+	for _, endpoint := range services {
+		if ctx.Err() != nil {
+			break
+		}
+		req, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint, nil)
+		if err != nil {
+			continue
+		}
+		resp, err := client.Do(req)
+		if err != nil {
+			continue
+		}
+		body, readErr := io.ReadAll(io.LimitReader(resp.Body, 65))
+		_ = resp.Body.Close()
+		if resp.StatusCode != http.StatusOK || readErr != nil || len(body) > 64 {
+			continue
+		}
+		ip := net.ParseIP(strings.TrimSpace(string(body)))
+		if ip != nil && (ip.To4() == nil) == ipv6 {
+			return ip.String()
+		}
+	}
+	return "N/A"
+}
+
+// CPU 拓樸低頻更新；查詢 goroutine 只寫入快取，不修改已發布的統計。
+type cpuMetadataCache struct {
+	mu          sync.Mutex
+	cores       int
+	mhz         float64
+	nextRefresh time.Time
+	pending     bool
+}
+
+func (c *cpuMetadataCache) snapshot(platform string) (int, float64) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.pending && !time.Now().Before(c.nextRefresh) {
+		c.pending = true
+		go c.refresh(platform)
+	}
+	return c.cores, c.mhz
+}
+
+func (c *cpuMetadataCache) refresh(platform string) {
+	ctx, cancel := context.WithTimeout(context.Background(), 1500*time.Millisecond)
+	defer cancel()
+	cores, coresErr := cpu.CountsWithContext(ctx, false)
+	infos, infoErr := cpu.InfoWithContext(ctx)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if coresErr == nil {
+		c.cores = cores
+	}
+	if infoErr == nil && len(infos) > 0 {
+		c.mhz = infos[0].Mhz
+	}
+	ttl := 5 * time.Minute
+	if platform == "android" {
+		ttl = 30 * time.Minute
+	}
+	if coresErr != nil || infoErr != nil || len(infos) == 0 {
+		ttl = time.Minute
+	}
+	c.nextRefresh = time.Now().Add(ttl)
+	c.pending = false
+}
+
+const androidDeniedMetricRetryTTL = 5 * time.Minute
+
+var errSamplingDeferred = errors.New("metric sampling deferred after permission denial")
+
+type androidSamplingCache struct {
+	mu          sync.Mutex
+	disk        *disk.UsageStat
+	diskPath    string
+	diskExpires time.Time
+	denied      map[string]time.Time
+}
+
+func (c *androidSamplingCache) diskUsage(platform, path string) (*disk.UsageStat, error) {
+	if platform != "android" {
+		return disk.Usage(path)
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.disk != nil && c.diskPath == path && time.Now().Before(c.diskExpires) {
+		return c.disk, nil
+	}
+	info, err := disk.Usage(path)
+	if err == nil {
+		c.disk, c.diskPath, c.diskExpires = info, path, time.Now().Add(30*time.Second)
+	}
+	return info, err
+}
+
+// Android 權限拒絕才延後重試；暫時性錯誤與可用的動態計數維持每輪取樣。
+func sampleAndroidMetric[T any](c *androidSamplingCache, platform, metric string, fetch func() (T, error)) (T, error) {
+	if platform != "android" {
+		return fetch()
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if time.Now().Before(c.denied[metric]) {
+		var zero T
+		return zero, errSamplingDeferred
+	}
+	value, err := fetch()
+	if errors.Is(err, os.ErrPermission) {
+		if c.denied == nil {
+			c.denied = make(map[string]time.Time)
+		}
+		c.denied[metric] = time.Now().Add(androidDeniedMetricRetryTTL)
+	} else {
+		delete(c.denied, metric)
+	}
+	return value, err
+}
