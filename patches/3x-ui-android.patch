+func TestPublicIPSnapshotDoesNotWaitForNetwork(t *testing.T) {
+	entered := make(chan struct{}, 2)
+	var requests, active, maximum atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		current := active.Add(1)
+		defer active.Add(-1)
+		for old := maximum.Load(); current > old && !maximum.CompareAndSwap(old, current); old = maximum.Load() {
+		}
+		entered <- struct{}{}
+		<-r.Context().Done()
+	}))
+	defer server.Close()
+	setPublicIPTestServices(t, []string{server.URL, server.URL}, []string{server.URL, server.URL})
+	cache := publicIPCache{}
+	start := time.Now()
+	ipv4, ipv6 := cache.snapshot()
+	if elapsed := time.Since(start); elapsed > 200*time.Millisecond {
+		t.Fatalf("snapshot waited %s for blocked network", elapsed)
+	}
+	if ipv4 != "N/A" || ipv6 != "N/A" {
+		t.Fatalf("pending snapshot = %q, %q", ipv4, ipv6)
+	}
+	for i := 0; i < 2; i++ {
+		select {
+		case <-entered:
+		case <-time.After(time.Second):
+			t.Fatal("IPv4 and IPv6 requests did not run concurrently")
+		}
+	}
+	var readers sync.WaitGroup
+	for i := 0; i < 100; i++ {
+		readers.Go(func() { cache.snapshot() })
+	}
+	readers.Wait()
+	cache.mu.Lock()
+	done := cache.pending
+	cache.mu.Unlock()
+	select {
+	case <-done:
+	case <-time.After(4 * time.Second):
+		t.Fatal("resolution exceeded shared deadline")
+	}
+	if got := requests.Load(); got != 2 {
+		t.Fatalf("blocked requests = %d, want 2", got)
+	}
+	if got := maximum.Load(); got != 2 {
+		t.Fatalf("peak concurrency = %d, want 2", got)
+	}
+	cache.snapshot()
+	if got := requests.Load(); got != 2 {
+		t.Fatalf("failed resolution was unexpectedly retried: %d", got)
+	}
+}
