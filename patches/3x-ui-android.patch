+
+func TestAndroidDeferredConnectionCountsDoNotRepeatWarnings(t *testing.T) {
+	initFlowTestDB(t)
+	// 只計算此 Go test 程序產生的固定診斷，不讀取裝置或後端日誌檔。
+	countWarnings := func() int {
+		count := 0
+		for _, message := range logger.GetLogs(10240, "WARNING") {
+			if strings.Contains(message, errSamplingDeferred.Error()) &&
+				(strings.Contains(message, "get tcp connections failed:") || strings.Contains(message, "get udp connections failed:")) {
+				count++
+			}
+		}
+		return count
+	}
+	before := countWarnings()
+	s := &ServerService{
+		androidPublicIPs: publicIPCache{resolved: true},
+		cpuMetadata:      cpuMetadataCache{nextRefresh: time.Now().Add(time.Hour)},
+		androidSampling: androidSamplingCache{denied: map[string]time.Time{
+			"tcp": time.Now().Add(androidDeniedMetricRetryTTL),
+			"udp": time.Now().Add(androidDeniedMetricRetryTTL),
+		}},
+	}
+	for range 3 {
+		status := s.getStatus(nil, "android")
+		if status.TcpCount != 0 || status.UdpCount != 0 {
+			t.Fatalf("deferred connection counts = %d, %d", status.TcpCount, status.UdpCount)
+		}
+	}
+	if count := countWarnings() - before; count != 0 {
+		t.Fatalf("deferred connection metrics emitted %d warnings, want zero", count)
+	}
+}
+
+func setPublicIPTestServices(t *testing.T, ipv4, ipv6 []string) {
+	t.Helper()
+	previous4, previous6 := publicIPv4Services, publicIPv6Services
+	publicIPv4Services, publicIPv6Services = ipv4, ipv6
+	t.Cleanup(func() { publicIPv4Services, publicIPv6Services = previous4, previous6 })
+}
+
+func TestPublicIPSnapshotDoesNotWaitForNetwork(t *testing.T) {
+	entered := make(chan struct{}, 2)
+	var requests, active, maximum atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		current := active.Add(1)
+		defer active.Add(-1)
+		for old := maximum.Load(); current > old && !maximum.CompareAndSwap(old, current); old = maximum.Load() {
+		}
+		entered <- struct{}{}
+		<-r.Context().Done()
+	}))
+	defer server.Close()
+	setPublicIPTestServices(t, []string{server.URL, server.URL}, []string{server.URL, server.URL})
+	cache := publicIPCache{}
+	start := time.Now()
+	ipv4, ipv6 := cache.snapshot()
+	if elapsed := time.Since(start); elapsed > 200*time.Millisecond {
+		t.Fatalf("snapshot waited %s for blocked network", elapsed)
+	}
+	if ipv4 != "N/A" || ipv6 != "N/A" {
+		t.Fatalf("pending snapshot = %q, %q", ipv4, ipv6)
+	}
+	for i := 0; i < 2; i++ {
+		select {
+		case <-entered:
+		case <-time.After(time.Second):
+			t.Fatal("IPv4 and IPv6 requests did not run concurrently")
+		}
+	}
+	var readers sync.WaitGroup
+	for i := 0; i < 100; i++ {
+		readers.Go(func() { cache.snapshot() })
+	}
+	readers.Wait()
+	cache.mu.Lock()
+	done := cache.pending
+	cache.mu.Unlock()
+	select {
+	case <-done:
+	case <-time.After(4 * time.Second):
+		t.Fatal("resolution exceeded shared deadline")
+	}
+	if got := requests.Load(); got != 2 {
+		t.Fatalf("blocked requests = %d, want 2", got)
+	}
+	if got := maximum.Load(); got != 2 {
+		t.Fatalf("peak concurrency = %d, want 2", got)
+	}
+	cache.snapshot()
+	if got := requests.Load(); got != 2 {
+		t.Fatalf("failed resolution was unexpectedly retried: %d", got)
+	}
+}
+
+func TestPublicIPCachePersistsUntilNewService(t *testing.T) {
+	var requests atomic.Int32
+	var failing atomic.Bool
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		if failing.Load() {
+			w.WriteHeader(http.StatusServiceUnavailable)
+			return
+		}
+		if r.URL.Path == "/4" {
+			fmt.Fprintln(w, "203.0.113.8")
+		} else {
+			fmt.Fprintln(w, "2001:db8::8")
+		}
+	}))
+	defer server.Close()
+	setPublicIPTestServices(t, []string{server.URL + "/4"}, []string{server.URL + "/6"})
+	cache := publicIPCache{}
+	ipv4, ipv6 := cache.load(true)
+	if ipv4 != "203.0.113.8" || ipv6 != "2001:db8::8" {
+		t.Fatalf("resolved addresses = %q, %q", ipv4, ipv6)
+	}
+	for i := 0; i < 10; i++ {
+		cache.snapshot()
+	}
+	if got := requests.Load(); got != 2 {
+		t.Fatalf("cached requests = %d, want 2", got)
+	}
+	failing.Store(true)
+	ipv4, ipv6 = cache.load(true)
+	if ipv4 != "203.0.113.8" || ipv6 != "2001:db8::8" {
+		t.Fatalf("cached addresses changed during same service lifetime: %q, %q", ipv4, ipv6)
+	}
+	if got := requests.Load(); got != 2 {
+		t.Fatalf("successful cache retried: %d requests, want 2", got)
+	}
+	failedCache := publicIPCache{}
+	ipv4, ipv6 = failedCache.load(true)
+	if ipv4 != "N/A" || ipv6 != "N/A" {
+		t.Fatalf("failed addresses = %q, %q", ipv4, ipv6)
+	}
+	failing.Store(false)
+	for i := 0; i < 100; i++ {
+		ipv4, ipv6 = failedCache.load(true)
+		if ipv4 != "N/A" || ipv6 != "N/A" {
+			t.Fatalf("failed cache changed during same service lifetime: %q, %q", ipv4, ipv6)
+		}
+	}
+	if got := requests.Load(); got != 4 {
+		t.Fatalf("failed cache retried: %d requests, want 4 total", got)
+	}
+	restartedCache := publicIPCache{}
+	ipv4, ipv6 = restartedCache.load(true)
+	if ipv4 != "203.0.113.8" || ipv6 != "2001:db8::8" {
+		t.Fatalf("new service failed to resolve: %q, %q", ipv4, ipv6)
+	}
+	if got := requests.Load(); got != 6 {
+		t.Fatalf("new service requests = %d, want 6 total", got)
+	}
+}
+
+func TestPublicIPRejectsInvalidAndWrongFamily(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/invalid":
+			fmt.Fprintln(w, "not an IP")
+		case "/4":
+			fmt.Fprintln(w, "203.0.113.9")
+		case "/6":
+			fmt.Fprintln(w, "2001:db8::9")
+		case "/large":
+			fmt.Fprintf(w, "%065d", 1)
+		}
+	}))
+	defer server.Close()
+	for _, tt := range []struct {
+		name      string
+		ipv6      bool
+		endpoints []string
+		want      string
+	}{
+		{"IPv4 fallback", false, []string{"/invalid", "/6", "/large", "/4"}, "203.0.113.9"},
+		{"IPv6 fallback", true, []string{"/invalid", "/4", "/6"}, "2001:db8::9"},
+		{"invalid response", false, []string{"/invalid", "/large"}, "N/A"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			endpoints := make([]string, len(tt.endpoints))
+			for i, endpoint := range tt.endpoints {
+				endpoints[i] = server.URL + endpoint
+			}
+			got := resolvePublicIP(context.Background(), server.Client(), endpoints, tt.ipv6)
+			if got != tt.want {
+				t.Fatalf("resolved IP = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestAndroidMetricDenialBackoffPreservesTransientRetry(t *testing.T) {
+	cache := androidSamplingCache{}
+	calls := 0
+	denied := func() (int, error) { calls++; return 0, fmt.Errorf("read /proc: %w", os.ErrPermission) }
+	_, err := sampleAndroidMetric(&cache, "android", "tcp", denied)
+	if !errors.Is(err, os.ErrPermission) {
+		t.Fatalf("first denial = %v", err)
+	}
+	for i := 0; i < 100; i++ {
+		_, err = sampleAndroidMetric(&cache, "android", "tcp", denied)
+		if !errors.Is(err, errSamplingDeferred) {
+			t.Fatalf("deferred denial = %v", err)
+		}
+	}
+	if calls != 1 {
+		t.Fatalf("denied metric calls = %d, want 1", calls)
+	}
+	cache.denied["tcp"] = time.Time{}
+	value, err := sampleAndroidMetric(&cache, "android", "tcp", func() (int, error) { return 42, nil })
+	if value != 42 || err != nil {
+		t.Fatalf("permission recovery = %d, %v", value, err)
+	}
+	transient := errors.New("temporary sample failure")
+	for i := 0; i < 2; i++ {
+		_, err = sampleAndroidMetric(&cache, "android", "tcp", func() (int, error) { calls++; return 0, transient })
+		if !errors.Is(err, transient) {
+			t.Fatalf("transient error = %v", err)
+		}
+	}
+	if calls != 3 {
+		t.Fatalf("transient calls = %d, want 3 total", calls)
+	}
+	for i := 0; i < 2; i++ {
+		sampleAndroidMetric(&cache, "linux", "tcp", denied)
+	}
+	if calls != 5 {
+		t.Fatalf("non-Android calls = %d, want 5 total", calls)
+	}
+}
+
+func TestAndroidDiskUsageRefreshesAfterExpiration(t *testing.T) {
+	cache := androidSamplingCache{}
+	path := t.TempDir()
+	initial, err := cache.diskUsage("android", path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	initial.Total = 123
+	cached, err := cache.diskUsage("android", path)
+	if err != nil || cached.Total != 123 {
+		t.Fatalf("unexpired disk cache = %v, %v", cached, err)
+	}
+	cache.diskExpires = time.Time{}
+	refreshed, err := cache.diskUsage("android", path)
+	if err != nil || refreshed.Total == 123 {
+		t.Fatalf("expired disk cache did not refresh: %v, %v", refreshed, err)
+	}
+}
+
+func TestCPUMetadataConcurrentSnapshots(t *testing.T) {
+	cache := cpuMetadataCache{}
+	var readers sync.WaitGroup
+	for i := 0; i < 100; i++ {
+		readers.Go(func() { cache.snapshot("android") })
+	}
+	readers.Wait()
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		cache.mu.Lock()
+		pending := cache.pending
+		cache.mu.Unlock()
+		if !pending {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("CPU metadata worker did not complete")
+}
+
+func TestGetStatusPublishesLocalSnapshotBeforeIPResolution(t *testing.T) {
+	initFlowTestDB(t)
+	release := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		select {
+		case <-release:
+			if r.URL.Path == "/4" {
+				fmt.Fprintln(w, "203.0.113.10")
+			} else {
+				fmt.Fprintln(w, "2001:db8::10")
+			}
+		case <-r.Context().Done():
+		}
+	}))
+	defer server.Close()
+	defer close(release)
+	setPublicIPTestServices(t, []string{server.URL + "/4"}, []string{server.URL + "/6"})
+	service := ServerService{}
+	start := time.Now()
+	status := service.getStatus(nil, "android")
+	if elapsed := time.Since(start); elapsed > 2*time.Second {
+		t.Fatalf("local status waited %s for network", elapsed)
+	}
+	if status.Disk.Total == 0 || status.Mem.Total == 0 {
+		t.Fatal("first local snapshot missing disk or memory statistics")
+	}
+	if status.PublicIP.IPv4 != "N/A" || status.PublicIP.IPv6 != "N/A" {
+		t.Fatalf("pending public IP = %v", status.PublicIP)
+	}
+}
