+func TestAndroidDiskUsageRefreshesAfterExpiration(t *testing.T) {
+	cache := androidSamplingCache{}
+	path := t.TempDir()
+	initial, err := cache.diskUsage("android", path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	initial.Total = 123
+	cached, err := cache.diskUsage("android", path)
+	if err != nil || cached.Total != 123 {
+		t.Fatalf("unexpired disk cache = %v, %v", cached, err)
+	}
+	cache.diskExpires = time.Time{}
+	refreshed, err := cache.diskUsage("android", path)
+	if err != nil || refreshed.Total == 123 {
+		t.Fatalf("expired disk cache did not refresh: %v, %v", refreshed, err)
+	}
+}
