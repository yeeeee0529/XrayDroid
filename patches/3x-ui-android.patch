+func TestAndroidTrafficSnapshotIsPrivateAndAtomic(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "traffic.json")
+	for sequence := int64(1); sequence < 3; sequence++ {
+		want := androidTrafficSnapshot{Session: "test-session", Sequence: sequence, State: "ready", Upload: 123, Download: 456}
+		if err := writeAndroidTraffic(file, want); err != nil {
+			t.Fatal(err)
+		}
+		data, err := os.ReadFile(file)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var got androidTrafficSnapshot
+		if err := json.Unmarshal(data, &got); err != nil || got != want {
+			t.Fatalf("snapshot mismatch: %+v, %v", got, err)
+		}
+		info, err := os.Stat(file)
+		if err != nil || info.Mode().Perm() != 0600 {
+			t.Fatalf("snapshot permissions: %v, %v", info, err)
+		}
+	}
+}
