+package xray
+
+import (
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+)
+
+func TestRefreshVersionUsesPackagedBinaryAndAssetDirectory(t *testing.T) {
+	if runtime.GOOS == "windows" || runtime.GOOS == "android" {
+		t.Skip("shell fixture requires a desktop Unix host")
+	}
+	directory := t.TempDir()
+	binary := filepath.Join(directory, "libxray.so")
+	fixture := "#!/bin/sh\nif [ \"$XRAY_LOCATION_ASSET\" = \"$XUI_BIN_FOLDER\" ]; then echo 'Xray 26.6.27'; else exit 9; fi\n"
+	if err := os.WriteFile(binary, []byte(fixture), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("XUI_XRAY_BINARY", binary)
+	t.Setenv("XUI_BIN_FOLDER", directory)
+	t.Setenv("XRAY_LOCATION_ASSET", "")
+	t.Setenv("xray.location.asset", "")
+	process := newProcess(&Config{})
+	process.refreshVersion()
+	if actual := process.GetXrayVersion(); actual != "26.6.27\n" {
+		t.Fatalf("packaged core version = %q, want 26.6.27", actual)
+	}
+}
