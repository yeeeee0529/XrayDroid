diff --git a/internal/web/service/android_traffic.go b/internal/web/service/android_traffic.go
new file mode 100644
index 0000000..99c3ff6
--- /dev/null
+++ b/internal/web/service/android_traffic.go
@@ -0,0 +1,170 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"runtime"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/util/json_util"
+	"github.com/mhsanaei/3x-ui/v3/internal/xray"
+	statsService "github.com/xtls/xray-core/app/stats/command"
+)
+
+var androidTrafficPublication struct {
+	sync.Mutex
+	sequence int64
+}
+
+type androidTrafficSnapshot struct {
+	Session  string  `json:"session"`
+	Sequence int64   `json:"sequence"`
+	State    string  `json:"state"`
+	Upload   float64 `json:"upload"`
+	Download float64 `json:"download"`
+}
+
+type androidTrafficMeter struct {
+	process  *xray.Process
+	previous map[string]int64
+	sampled  time.Time
+}
+
+func (m *androidTrafficMeter) sample(process *xray.Process, counters map[string]int64, now time.Time) androidTrafficSnapshot {
+	result := androidTrafficSnapshot{State: "waiting"}
+	elapsed := now.Sub(m.sampled)
+	if m.previous != nil && process == m.process && elapsed > 0 && elapsed <= 3*time.Second {
+		result.State = "ready"
+		for name, value := range counters {
+			parts := strings.Split(name, ">>>")
+			if len(parts) != 4 || parts[0] != "outbound" || parts[2] != "traffic" ||
+				(parts[3] != "uplink" && parts[3] != "downlink") {
+				continue
+			}
+			previous := m.previous[name]
+			if value < previous || value < 0 {
+				result = androidTrafficSnapshot{State: "waiting"}
+				break
+			}
+			rate := float64(value-previous) / elapsed.Seconds()
+			if parts[3] == "uplink" {
+				result.Upload += rate
+			} else {
+				result.Download += rate
+			}
+		}
+	}
+	m.process, m.previous, m.sampled = process, counters, now
+	return result
+}
+
+func enableAndroidOutboundStats(c *xray.Config) error {
+	policy := make(map[string]any)
+	if len(c.Policy) > 0 && string(c.Policy) != "null" {
+		if err := json.Unmarshal(c.Policy, &policy); err != nil {
+			return err
+		}
+	}
+	system, _ := policy["system"].(map[string]any)
+	if system == nil {
+		system = make(map[string]any)
+	}
+	system["statsOutboundUplink"], system["statsOutboundDownlink"] = true, true
+	policy["system"] = system
+	data, err := json.Marshal(policy)
+	if err != nil {
+		return err
+	}
+	c.Policy = json_util.RawMessage(data)
+	c.Stats = json_util.RawMessage(`{}`)
+	return nil
+}
+
+func queryAndroidOutboundTraffic(ctx context.Context) (*xray.Process, map[string]int64, error) {
+	process := currentXrayProcess()
+	if process == nil || !process.IsRunning() {
+		return nil, nil, ErrXrayNotRunning
+	}
+	// 使用獨立用戶端與非重設查詢，不干擾面板的累計／配額基準。
+	var api xray.XrayAPI
+	if err := api.Init(process.GetAPIPort()); err != nil {
+		return nil, nil, err
+	}
+	defer api.Close()
+	ctx, cancel := context.WithTimeout(ctx, 750*time.Millisecond)
+	defer cancel()
+	response, err := (*api.StatsServiceClient).QueryStats(ctx, &statsService.QueryStatsRequest{Pattern: "outbound>>>", Reset_: false})
+	if err != nil {
+		return nil, nil, err
+	}
+	if currentXrayProcess() != process || !process.IsRunning() {
+		return nil, nil, ErrXrayNotRunning
+	}
+	counters := make(map[string]int64, len(response.GetStat()))
+	for _, stat := range response.GetStat() {
+		counters[stat.Name] = stat.Value
+	}
+	return process, counters, nil
+}
+
+func writeAndroidTraffic(file string, snapshot androidTrafficSnapshot) error {
+	data, err := json.Marshal(snapshot)
+	if err != nil {
+		return err
+	}
+	temporary := file + ".tmp"
+	if err := os.WriteFile(temporary, data, 0600); err != nil {
+		return err
+	}
+	if err := os.Rename(temporary, file); err != nil {
+		_ = os.Remove(temporary)
+		return err
+	}
+	return nil
+}
+
+// StartAndroidTraffic 只發布出站速率，不包含標籤、帳號、設定或原始核心輸出。
+func StartAndroidTraffic(ctx context.Context) {
+	file, session := os.Getenv("XUI_ANDROID_TRAFFIC_FILE"), os.Getenv("XUI_ANDROID_TRAFFIC_SESSION")
+	if runtime.GOOS != "android" || file == "" || session == "" {
+		return
+	}
+	go runAndroidTraffic(ctx, file, session)
+}
+
+func runAndroidTraffic(ctx context.Context, file, session string) {
+	ticker := time.NewTicker(time.Second)
+	defer ticker.Stop()
+	var meter androidTrafficMeter
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			process, counters, err := queryAndroidOutboundTraffic(ctx)
+			snapshot := androidTrafficSnapshot{State: "unavailable"}
+			if err == nil {
+				snapshot = meter.sample(process, counters, time.Now())
+			} else {
+				meter = androidTrafficMeter{}
+			}
+			snapshot.Session = session
+			publishAndroidTraffic(ctx, file, snapshot)
+		}
+	}
+}
+
+func publishAndroidTraffic(ctx context.Context, file string, snapshot androidTrafficSnapshot) {
+	// 同一個程序的序號跨面板重啟保留；交接時不讓已取消的工作覆寫新快照。
+	androidTrafficPublication.Lock()
+	defer androidTrafficPublication.Unlock()
+	if ctx.Err() != nil {
+		return
+	}
+	androidTrafficPublication.sequence++
+	snapshot.Sequence = androidTrafficPublication.sequence
+	_ = writeAndroidTraffic(file, snapshot)
+}
