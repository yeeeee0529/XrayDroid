+func TestAndroidTrafficFiltersCountersAndLongGaps(t *testing.T) {
+	var meter androidTrafficMeter
+	process := new(xray.Process)
+	now := time.Now()
+	meter.sample(process, map[string]int64{}, now)
+	got := meter.sample(process, map[string]int64{
+		"outbound>>>direct>>>traffic>>>uplink":   100,
+		"outbound>>>proxy>>>traffic>>>uplink":    200,
+		"outbound>>>direct>>>traffic>>>downlink": 900,
+		"inbound>>>api>>>traffic>>>uplink":       99999,
+		"user>>>fixture>>>traffic>>>downlink":    99999,
+	}, now.Add(time.Second))
+	if got.Upload != 300 || got.Download != 900 {
+		t.Fatalf("only outbound counters must be counted: %+v", got)
+	}
+	if got := meter.sample(process, map[string]int64{}, now.Add(10*time.Second)); got.State != "waiting" {
+		t.Fatalf("long gap must rebaseline: %+v", got)
+	}
+}
