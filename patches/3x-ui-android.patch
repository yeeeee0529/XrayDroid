+func TestPublicIPRejectsInvalidAndWrongFamily(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/invalid":
+			fmt.Fprintln(w, "not an IP")
+		case "/4":
+			fmt.Fprintln(w, "203.0.113.9")
+		case "/6":
+			fmt.Fprintln(w, "2001:db8::9")
+		case "/large":
+			fmt.Fprintf(w, "%065d", 1)
+		}
+	}))
+	defer server.Close()
+	for _, tt := range []struct {
+		name      string
+		ipv6      bool
+		endpoints []string
+		want      string
+	}{
+		{"IPv4 fallback", false, []string{"/invalid", "/6", "/large", "/4"}, "203.0.113.9"},
+		{"IPv6 fallback", true, []string{"/invalid", "/4", "/6"}, "2001:db8::9"},
+		{"invalid response", false, []string{"/invalid", "/large"}, "N/A"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			endpoints := make([]string, len(tt.endpoints))
+			for i, endpoint := range tt.endpoints {
+				endpoints[i] = server.URL + endpoint
+			}
+			got := resolvePublicIP(context.Background(), server.Client(), endpoints, tt.ipv6)
+			if got != tt.want {
+				t.Fatalf("resolved IP = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
