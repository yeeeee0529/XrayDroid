diff --git a/common/net/android_network_test.go b/common/net/android_network_test.go
new file mode 100644
index 0000000..4023efa
--- /dev/null
+++ b/common/net/android_network_test.go
@@ -0,0 +1,16 @@
+package net
+
+import "testing"
+
+func TestParseAndroidNetworkHandle(t *testing.T) {
+	for _, value := range []string{"", "0", "644245094401", "18446744073709551615"} {
+		if _, err := parseAndroidNetworkHandle(value); err != nil {
+			t.Errorf("valid handle %q: %v", value, err)
+		}
+	}
+	for _, value := range []string{"-1", "abc", " 0", "1.0", "18446744073709551616"} {
+		if _, err := parseAndroidNetworkHandle(value); err == nil {
+			t.Errorf("accepted invalid handle %q", value)
+		}
+	}
+}
