diff --git a/common/net/android_network.go b/common/net/android_network.go
new file mode 100644
index 0000000..5e51d3d
--- /dev/null
+++ b/common/net/android_network.go
@@ -0,0 +1,51 @@
+package net
+
+import (
+	"fmt"
+	"strconv"
+	"syscall"
+)
+
+func parseAndroidNetworkHandle(value string) (uint64, error) {
+	if value == "" {
+		return 0, nil
+	}
+	handle, err := strconv.ParseUint(value, 10, 64)
+	if err != nil {
+		return 0, fmt.Errorf("invalid XRAY_ANDROID_NETWORK_HANDLE: %w", err)
+	}
+	return handle, nil
+}
+
+// NetworkControl 保留既有 socket 選項，最後套用 Android 指定網路並傳回錯誤。
+func NetworkControl(destination string, previous func(string, string, syscall.RawConn) error) func(string, string, syscall.RawConn) error {
+	if !AndroidNetworkSelected() {
+		return previous
+	}
+	return func(network, address string, raw syscall.RawConn) error {
+		if previous != nil {
+			if err := previous(network, address, raw); err != nil {
+				return err
+			}
+		}
+		if destination != "" {
+			address = destination
+		}
+		return androidNetworkControl(network, address, raw, false)
+	}
+}
+
+// InboundNetworkControl 讓入站監聽及本機管理連線維持原本的網路行為。
+func InboundNetworkControl(previous func(string, string, syscall.RawConn) error) func(string, string, syscall.RawConn) error {
+	if !AndroidNetworkSelected() {
+		return previous
+	}
+	return func(network, address string, raw syscall.RawConn) error {
+		if previous != nil {
+			if err := previous(network, address, raw); err != nil {
+				return err
+			}
+		}
+		return androidNetworkControl(network, address, raw, true)
+	}
+}
diff --git a/common/net/android_network_android.go b/common/net/android_network_android.go
new file mode 100644
index 0000000..db4d06f
--- /dev/null
+++ b/common/net/android_network_android.go
@@ -0,0 +1,80 @@
+//go:build android && cgo
+
+package net
+
+/*
+#cgo LDFLAGS: -landroid
+#include <android/multinetwork.h>
+#include <errno.h>
+#include <stdint.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+static int xray_bind_process(uint64_t handle) {
+    int fd = socket(AF_INET, SOCK_DGRAM, 0);
+    if (fd < 0) return errno;
+    int result = android_setsocknetwork((net_handle_t)handle, fd);
+    int error = result == 0 ? 0 : errno;
+    close(fd);
+    if (error != 0) return error;
+    return android_setprocnetwork((net_handle_t)handle) == 0 ? 0 : errno;
+}
+static int xray_bind_socket(uint64_t handle, int fd) {
+    return android_setsocknetwork((net_handle_t)handle, fd) == 0 ? 0 : errno;
+}
+*/
+import "C"
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"strings"
+	"syscall"
+)
+
+var androidNetworkHandle uint64
+
+func init() {
+	handle, err := parseAndroidNetworkHandle(os.Getenv("XRAY_ANDROID_NETWORK_HANDLE"))
+	if err == nil && handle != 0 {
+		if code := C.xray_bind_process(C.uint64_t(handle)); code != 0 {
+			err = fmt.Errorf("cannot bind Android network: %w", syscall.Errno(code))
+		}
+	}
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(78)
+	}
+	androidNetworkHandle = handle
+}
+
+func AndroidNetworkSelected() bool { return androidNetworkHandle != 0 }
+
+func androidNetworkControl(network, address string, raw syscall.RawConn, inbound bool) error {
+	if strings.HasPrefix(network, "unix") {
+		return nil
+	}
+	handle := androidNetworkHandle
+	host, _, err := net.SplitHostPort(address)
+	if err == nil {
+		if i := strings.LastIndexByte(host, '%'); i >= 0 {
+			host = host[:i]
+		}
+		if ip := net.ParseIP(host); ip != nil && ip.IsLoopback() {
+			handle = 0
+		}
+	}
+	if inbound {
+		handle = 0
+	}
+	var bindError error
+	if err := raw.Control(func(fd uintptr) {
+		if code := C.xray_bind_socket(C.uint64_t(handle), C.int(fd)); code != 0 {
+			bindError = fmt.Errorf("cannot bind Android socket: %w", syscall.Errno(code))
+		}
+	}); err != nil {
+		return err
+	}
+	return bindError
+}
