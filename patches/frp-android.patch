diff --git a/pkg/util/androidnet/network.go b/pkg/util/androidnet/network.go
new file mode 100644
index 0000000..d5fdfb0
--- /dev/null
+++ b/pkg/util/androidnet/network.go
@@ -0,0 +1,151 @@
+package androidnet
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"net/http"
+	"strconv"
+	"strings"
+	"syscall"
+)
+
+const HandleEnvironment = "XRAYDROID_FRP_NETWORK_HANDLE"
+
+var networkHandle uint64
+
+func parseHandle(value string) (uint64, error) {
+	if value == "" {
+		return 0, nil
+	}
+	handle, err := strconv.ParseUint(value, 10, 64)
+	if err != nil {
+		return 0, fmt.Errorf("invalid %s: %w", HandleEnvironment, err)
+	}
+	return handle, nil
+}
+
+func initialize(value string, bind func(uint64) error) (uint64, error) {
+	handle, err := parseHandle(value)
+	if err != nil {
+		return 0, err
+	}
+	if handle != 0 {
+		if err := bind(handle); err != nil {
+			return 0, err
+		}
+	}
+	return handle, nil
+}
+
+func Selected() bool { return networkHandle != 0 }
+
+type controlFunc = func(string, string, syscall.RawConn) error
+
+// 先保留既有通訊端選項；本機回送與入站監聽明確解除程序網路綁定。
+func socketControl(handle uint64, inbound bool, previous controlFunc, bind func(uint64, int) error) controlFunc {
+	if handle == 0 {
+		return previous
+	}
+	return func(network, address string, raw syscall.RawConn) error {
+		if previous != nil {
+			if err := previous(network, address, raw); err != nil {
+				return err
+			}
+		}
+		if strings.HasPrefix(network, "unix") {
+			return nil
+		}
+		target := handle
+		host, _, err := net.SplitHostPort(address)
+		if err == nil {
+			if i := strings.LastIndexByte(host, '%'); i >= 0 {
+				host = host[:i]
+			}
+			if ip := net.ParseIP(host); ip != nil && ip.IsLoopback() {
+				target = 0
+			}
+		}
+		if inbound {
+			target = 0
+		}
+		var bindErr error
+		if err := raw.Control(func(fd uintptr) { bindErr = bind(target, int(fd)) }); err != nil {
+			return err
+		}
+		return bindErr
+	}
+}
+
+func Control(previous controlFunc) controlFunc {
+	return socketControl(networkHandle, false, previous, bindSocket)
+}
+func InboundControl(previous controlFunc) controlFunc {
+	return socketControl(networkHandle, true, previous, bindSocket)
+}
+
+func DialContext(ctx context.Context, network, address string) (net.Conn, error) {
+	d := net.Dialer{Control: Control(nil)}
+	return d.DialContext(ctx, network, address)
+}
+
+func Listen(network, address string) (net.Listener, error) {
+	lc := net.ListenConfig{Control: InboundControl(nil)}
+	return lc.Listen(context.Background(), network, address)
+}
+
+// 入站與 NAT 穿透分開處理；後者必須使用指定網路。
+func ListenUDP(network string, address *net.UDPAddr, inbound bool) (*net.UDPConn, error) {
+	if !Selected() {
+		return net.ListenUDP(network, address)
+	}
+	text := ":0"
+	if address != nil {
+		text = address.String()
+	}
+	lc := net.ListenConfig{Control: socketControl(networkHandle, inbound, nil, bindSocket)}
+	c, err := lc.ListenPacket(context.Background(), network, text)
+	if err != nil {
+		return nil, err
+	}
+	return c.(*net.UDPConn), nil
+}
+
+func DialUDP(network string, local, remote *net.UDPAddr) (*net.UDPConn, error) {
+	if !Selected() {
+		return net.DialUDP(network, local, remote)
+	}
+	d := net.Dialer{Control: Control(nil)}
+	if local != nil {
+		d.LocalAddr = local
+	}
+	c, err := d.Dial(network, remote.String())
+	if err != nil {
+		return nil, err
+	}
+	return c.(*net.UDPConn), nil
+}
+
+func ListenUDPForRemote(network string, remote *net.UDPAddr) (*net.UDPConn, error) {
+	control := Control(nil)
+	lc := net.ListenConfig{}
+	if control != nil {
+		lc.Control = func(network, _ string, raw syscall.RawConn) error { return control(network, remote.String(), raw) }
+	}
+	address := "0.0.0.0:0"
+	if remote.IP.To4() == nil {
+		address = "[::]:0"
+	}
+	conn, err := lc.ListenPacket(context.Background(), network, address)
+	if err != nil {
+		return nil, err
+	}
+	return conn.(*net.UDPConn), nil
+}
+
+func ConfigureHTTPTransport(transport *http.Transport) {
+	if Selected() {
+		d := net.Dialer{Control: Control(nil)}
+		transport.DialContext = d.DialContext
+	}
+}
diff --git a/pkg/util/androidnet/network_android.go b/pkg/util/androidnet/network_android.go
new file mode 100644
index 0000000..c48acb8
--- /dev/null
+++ b/pkg/util/androidnet/network_android.go
@@ -0,0 +1,62 @@
+//go:build android && cgo
+
+package androidnet
+
+/*
+#cgo LDFLAGS: -landroid
+#include <android/multinetwork.h>
+#include <errno.h>
+#include <stdint.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+static int frpc_bind_process(uint64_t handle) {
+    int fd = socket(AF_INET, SOCK_DGRAM, 0);
+    if (fd < 0) return errno;
+    int result = android_setsocknetwork((net_handle_t)handle, fd);
+    int error = result == 0 ? 0 : errno;
+    close(fd);
+    if (error != 0) return error;
+    return android_setprocnetwork((net_handle_t)handle) == 0 ? 0 : errno;
+}
+static int frpc_bind_socket(uint64_t handle, int fd) {
+    return android_setsocknetwork((net_handle_t)handle, fd) == 0 ? 0 : errno;
+}
+*/
+import "C"
+
+import (
+	"fmt"
+	"net"
+	"net/http"
+	"os"
+	"syscall"
+)
+
+func Initialize() error {
+	handle, err := initialize(os.Getenv(HandleEnvironment), func(handle uint64) error {
+		if code := C.frpc_bind_process(C.uint64_t(handle)); code != 0 {
+			return fmt.Errorf("cannot bind Android network: %w", syscall.Errno(code))
+		}
+		return nil
+	})
+	if err != nil {
+		return err
+	}
+	networkHandle = handle
+	if Selected() {
+		// Android 的 libc 解析器使用程序所綁定網路，不能改走公共 DNS。
+		net.DefaultResolver = &net.Resolver{PreferGo: false}
+		transport := http.DefaultTransport.(*http.Transport).Clone()
+		ConfigureHTTPTransport(transport)
+		http.DefaultTransport = transport
+	}
+	return nil
+}
+
+func bindSocket(handle uint64, fd int) error {
+	if code := C.frpc_bind_socket(C.uint64_t(handle), C.int(fd)); code != 0 {
+		return fmt.Errorf("cannot bind Android socket: %w", syscall.Errno(code))
+	}
+	return nil
+}
