+func TestAppConnectionErrorDoesNotExposeRawErrors(t *testing.T) {
+	tests := []struct {
+		err  error
+		code string
+	}{
+		{&net.DNSError{Err: "private.example", Name: "private.example"}, "dns"},
+		{fmt.Errorf("private address: %w", syscall.ECONNREFUSED), "refused"},
+		{syscall.ENETUNREACH, "unreachable"},
+		{&net.DNSError{IsTimeout: true}, "dns"},
+		{&net.OpError{Err: syscall.ETIMEDOUT}, "timeout"},
+		{&tls.CertificateVerificationError{Err: x509.UnknownAuthorityError{}}, "tls"},
+		{appLoginError{"login_rejected", errors.New("private-token")}, "login_rejected"},
+		{appLoginError{"authentication", errors.New("private-token")}, "authentication"},
+		// 伺服器在回應登入前關閉連線；tcpMux 不一致只會以此形式出現，
+		// 不能落回泛用的 connection 分類。
+		{io.EOF, "closed"},
+		{fmt.Errorf("read login response: %w", io.EOF), "closed"},
+		{fmt.Errorf("read login response: %w", io.ErrUnexpectedEOF), "closed"},
+		{errors.New("private-token"), "connection"},
+	}
+	for _, tc := range tests {
+		if got := appConnectionError(tc.err); got != tc.code {
+			t.Errorf("error code = %q, want %q", got, tc.code)
+		}
+	}
+}
+
+func TestAppStatusRequiresAuthenticationAndReportsFailedLogin(t *testing.T) {
+	svr, err := NewService(ServiceOptions{
+		Common:                 &v1.ClientCommonConfig{},
+		ConfigSourceAggregator: source.NewAggregator(source.NewConfigSource()),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	router := mux.NewRouter()
+	svr.registerRouteHandlers(&httppkg.RouterRegisterHelper{
+		Router:         router,
+		AuthMiddleware: netpkg.NewHTTPAuthMiddleware("fixture-user", "fixture-password").Middleware,
+	})
+	request := httptest.NewRequest(http.MethodGet, "/api/xraydroid/status", nil)
+	response := httptest.NewRecorder()
+	router.ServeHTTP(response, request)
+	if response.Code != http.StatusUnauthorized {
+		t.Fatalf("unauthenticated status = %d", response.Code)
+	}
+	svr.beginConnectionAttempt()
+	svr.failConnectionAttempt(appLoginError{"login_rejected", errors.New("private-token")})
+	request.SetBasicAuth("fixture-user", "fixture-password")
+	response = httptest.NewRecorder()
+	router.ServeHTTP(response, request)
+	if response.Code != http.StatusOK {
+		t.Fatalf("authenticated status = %d", response.Code)
+	}
+	if strings.Contains(response.Body.String(), "private-token") {
+		t.Fatal("raw login error leaked")
+	}
+	var payload struct {
+		Connection appConnectionStatus
+		Proxies    []any
+	}
+	if err := json.Unmarshal(response.Body.Bytes(), &payload); err != nil {
+		t.Fatal(err)
+	}
+	if payload.Connection.State != "retrying" || payload.Connection.Error != "login_rejected" || payload.Connection.Attempts != 1 || len(payload.Proxies) != 0 {
+		t.Fatalf("unexpected safe status: %+v", payload)
+	}
+	// 重試開始時保留上次原因，避免畫面每次重試都閃回未知狀態。
+	svr.beginConnectionAttempt()
+	if got := svr.currentConnectionStatus(); got.Error != "login_rejected" || got.Attempts != 2 {
+		t.Fatalf("lost failure: %+v", got)
+	}
+}
+
+func TestAppStatusReportsServerClosedLoginAsOwnCode(t *testing.T) {
+	svr, err := NewService(ServiceOptions{
+		Common:                 &v1.ClientCommonConfig{},
+		ConfigSourceAggregator: source.NewAggregator(source.NewConfigSource()),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	router := mux.NewRouter()
+	svr.registerRouteHandlers(&httppkg.RouterRegisterHelper{
+		Router:         router,
+		AuthMiddleware: netpkg.NewHTTPAuthMiddleware("fixture-user", "fixture-password").Middleware,
+	})
+	svr.beginConnectionAttempt()
+	// tcpMux 不一致時用戶端只會收到單純的 EOF，而非伺服器送出的訊息。
+	svr.failConnectionAttempt(io.EOF)
+	request := httptest.NewRequest(http.MethodGet, "/api/xraydroid/status", nil)
+	request.SetBasicAuth("fixture-user", "fixture-password")
+	response := httptest.NewRecorder()
+	router.ServeHTTP(response, request)
+	if response.Code != http.StatusOK {
+		t.Fatalf("authenticated status = %d", response.Code)
+	}
+	var payload struct {
+		Connection appConnectionStatus
+	}
+	if err := json.Unmarshal(response.Body.Bytes(), &payload); err != nil {
+		t.Fatal(err)
+	}
+	if payload.Connection.State != "retrying" || payload.Connection.Error != "closed" {
+		t.Fatalf("closed login status: %+v", payload.Connection)
+	}
+}
+
+func TestAppStatusNeverReportsClosedControlConnected(t *testing.T) {
+	svr := &Service{ctl: &Control{doneCh: make(chan struct{})}}
+	svr.beginConnectionAttempt()
+	svr.completeConnectionAttempt()
+	close(svr.ctl.doneCh)
+	payload, err := svr.appStatus(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	encoded, err := json.Marshal(payload)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(encoded), `"state":"reconnecting"`) || !strings.Contains(string(encoded), `"proxies":[]`) {
+		t.Fatalf("closed controller status: %s", encoded)
+	}
+	svr.beginConnectionAttempt()
+	svr.failConnectionAttempt(syscall.ECONNREFUSED)
+	if got := svr.currentConnectionStatus(); got.State != "reconnecting" || got.Error != "refused" {
+		t.Fatalf("lost reconnect state: %+v", got)
+	}
+	svr.completeConnectionAttempt()
+	if got := svr.currentConnectionStatus(); got.State != "connected" || got.Error != "" {
+		t.Fatalf("failure survived recovery: %+v", got)
+	}
+}
