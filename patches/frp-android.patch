diff --git a/pkg/util/androidnet/network_test.go b/pkg/util/androidnet/network_test.go
new file mode 100644
index 0000000..6678a94
--- /dev/null
+++ b/pkg/util/androidnet/network_test.go
@@ -0,0 +1,140 @@
+package androidnet
+
+import (
+	"errors"
+	"net"
+	"syscall"
+	"testing"
+)
+
+func TestInitializeFailsClosed(t *testing.T) {
+	for _, value := range []string{"-1", "abc", " 0", "+1", "1.0", "18446744073709551616"} {
+		t.Run(value, func(t *testing.T) {
+			handle, err := initialize(value, func(uint64) error { t.Fatal("invalid handle reached binder"); return nil })
+			if err == nil || handle != 0 {
+				t.Fatalf("invalid selection accepted: %d, %v", handle, err)
+			}
+		})
+	}
+	for _, value := range []string{"", "0"} {
+		handle, err := initialize(value, func(uint64) error { t.Fatal("system default reached binder"); return nil })
+		if err != nil || handle != 0 {
+			t.Fatalf("system default rejected: %d, %v", handle, err)
+		}
+	}
+	const selected = uint64(644245094401)
+	got, err := initialize("644245094401", func(handle uint64) error {
+		if handle != selected {
+			t.Fatalf("handle truncated: %d", handle)
+		}
+		return nil
+	})
+	if err != nil || got != selected {
+		t.Fatalf("valid selection failed: %d, %v", got, err)
+	}
+	got, err = initialize("644245094401", func(uint64) error { return syscall.EPERM })
+	if got != 0 || !errors.Is(err, syscall.EPERM) {
+		t.Fatalf("binding failure ignored: %d, %v", got, err)
+	}
+}
+
+type rawConn struct {
+	err   error
+	calls int
+}
+
+func (r *rawConn) Control(fn func(uintptr)) error {
+	r.calls++
+	if r.err != nil {
+		return r.err
+	}
+	fn(42)
+	return nil
+}
+func (*rawConn) Read(func(uintptr) bool) error  { panic("unexpected read") }
+func (*rawConn) Write(func(uintptr) bool) error { panic("unexpected write") }
+
+func TestSocketControlKeepsLoopbackAndInboundLocal(t *testing.T) {
+	for _, tc := range []struct {
+		network, address string
+		inbound          bool
+		want             uint64
+		calls            int
+	}{
+		{"tcp4", "203.0.113.1:7000", false, 123, 1},
+		{"udp4", "192.168.1.2:7000", false, 123, 1},
+		{"tcp6", "[2001:db8::1]:7000", false, 123, 1},
+		{"tcp4", "127.0.0.1:7000", false, 0, 1},
+		{"udp4", "127.1.2.3:7000", false, 0, 1},
+		{"tcp6", "[::1]:7000", false, 0, 1},
+		{"tcp6", "[::ffff:127.0.0.1]:7000", false, 0, 1},
+		{"tcp6", "[::1%lo]:7000", false, 0, 1},
+		{"tcp", "0.0.0.0:2053", true, 0, 1},
+		{"udp6", "[::]:7000", true, 0, 1},
+		{"unix", "/tmp/frpc.sock", false, 0, 0},
+	} {
+		t.Run(tc.network+tc.address, func(t *testing.T) {
+			previous := false
+			raw := &rawConn{}
+			control := socketControl(123, tc.inbound, func(string, string, syscall.RawConn) error { previous = true; return nil }, func(handle uint64, fd int) error {
+				if !previous {
+					t.Fatal("previous options skipped")
+				}
+				if handle != tc.want || fd != 42 {
+					t.Fatalf("binding = %d/%d, want %d/42", handle, fd, tc.want)
+				}
+				return nil
+			})
+			if err := control(tc.network, tc.address, raw); err != nil {
+				t.Fatal(err)
+			}
+			if !previous || raw.calls != tc.calls {
+				t.Fatalf("control calls = %d, want %d", raw.calls, tc.calls)
+			}
+		})
+	}
+}
+
+func TestSocketControlPropagatesEveryFailure(t *testing.T) {
+	for _, stage := range []string{"previous", "raw", "binding", "loopback"} {
+		t.Run(stage, func(t *testing.T) {
+			raw := &rawConn{}
+			if stage == "raw" {
+				raw.err = syscall.EBADF
+			}
+			control := socketControl(123, false, func(string, string, syscall.RawConn) error {
+				if stage == "previous" {
+					return syscall.EBADF
+				}
+				return nil
+			}, func(uint64, int) error { return syscall.EBADF })
+			address := "203.0.113.1:7000"
+			if stage == "loopback" {
+				address = "127.0.0.1:7000"
+			}
+			if err := control("tcp", address, raw); !errors.Is(err, syscall.EBADF) {
+				t.Fatalf("failure ignored: %v", err)
+			}
+			if stage == "previous" && raw.calls != 0 {
+				t.Fatal("bound after previous error")
+			}
+		})
+	}
+}
+
+func TestFailedBindingPreventsTCPAndUDPDial(t *testing.T) {
+	for _, network := range []string{"tcp4", "udp4"} {
+		t.Run(network, func(t *testing.T) {
+			calls := 0
+			d := net.Dialer{Control: socketControl(123, false, nil, func(uint64, int) error { calls++; return syscall.EPERM })}
+			conn, err := d.Dial(network, "127.0.0.1:9")
+			if conn != nil {
+				conn.Close()
+				t.Fatal("connection opened after failed binding")
+			}
+			if !errors.Is(err, syscall.EPERM) || calls == 0 {
+				t.Fatalf("binding failure lost: %v, calls %d", err, calls)
+			}
+		})
+	}
+}
