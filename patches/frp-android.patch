diff --git a/client/android_connector.go b/client/android_connector.go
new file mode 100644
index 0000000..7706dea
--- /dev/null
+++ b/client/android_connector.go
@@ -0,0 +1,238 @@
+package client
+
+import (
+	"bufio"
+	"context"
+	"crypto/tls"
+	"encoding/base64"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/Azure/go-ntlmssp"
+	libnet "github.com/fatedier/golib/net"
+	kcp "github.com/xtaci/kcp-go/v5"
+	"golang.org/x/net/proxy"
+
+	"github.com/fatedier/frp/pkg/util/androidnet"
+	netpkg "github.com/fatedier/frp/pkg/util/net"
+	"github.com/samber/lo"
+)
+
+// golib 沒有公開的通訊端控制鉤子；指定網路時在 connect 前建立並綁定通訊端。
+func (c *defaultConnectorImpl) androidConnect(tlsConfig *tls.Config) (net.Conn, error) {
+	destination := net.JoinHostPort(c.cfg.ServerAddr, fmt.Sprint(c.cfg.ServerPort))
+	proxyType, proxyAddress, auth, err := libnet.ParseProxyURL(c.cfg.Transport.ProxyURL)
+	if err != nil {
+		return nil, err
+	}
+	protocol := c.cfg.Transport.Protocol
+	if protocol == "kcp" {
+		if proxyAddress != "" {
+			return nil, fmt.Errorf("KCP proxy is unsupported with a selected Android network")
+		}
+		remote, err := net.ResolveUDPAddr("udp", destination)
+		if err != nil {
+			return nil, err
+		}
+		udpConn, err := androidnet.ListenUDPForRemote("udp", remote)
+		if err != nil {
+			return nil, err
+		}
+		conn, err := kcp.NewConn2(remote, nil, 10, 3, udpConn)
+		if err != nil {
+			udpConn.Close()
+			return nil, err
+		}
+		conn.SetStreamMode(true)
+		conn.SetWriteDelay(true)
+		conn.SetNoDelay(1, 20, 2, 1)
+		conn.SetWindowSize(128, 512)
+		conn.SetMtu(1350)
+		conn.SetACKNoDelay(false)
+		_ = conn.SetReadBuffer(4194304)
+		_ = conn.SetWriteBuffer(4194304)
+		// KCP 的外部通訊端由呼叫者負責關閉。
+		stream := &androidPacketStream{Conn: conn, packet: udpConn}
+		_, wrapped, err := netpkg.DialHookCustomTLSHeadByte(tlsConfig != nil, lo.FromPtr(c.cfg.Transport.TLS.DisableCustomTLSFirstByte))(c.ctx, stream, destination)
+		if err != nil {
+			stream.Close()
+			return nil, err
+		}
+		if tlsConfig != nil {
+			wrapped = tls.Client(wrapped, tlsConfig)
+		}
+		return wrapped, nil
+	}
+	if protocol != "tcp" && protocol != "websocket" && protocol != "wss" {
+		return nil, fmt.Errorf("unsupported selected Android network protocol: %s", protocol)
+	}
+	dialer := net.Dialer{
+		Timeout:   time.Duration(c.cfg.Transport.DialServerTimeout) * time.Second,
+		KeepAlive: time.Duration(c.cfg.Transport.DialServerKeepAlive) * time.Second,
+		Control:   androidnet.Control(nil),
+	}
+	if address := c.cfg.Transport.ConnectServerLocalIP; address != "" {
+		local, err := net.ResolveTCPAddr("tcp", net.JoinHostPort(address, "0"))
+		if err != nil {
+			return nil, err
+		}
+		dialer.LocalAddr = local
+	}
+	ctx, cancel := context.WithTimeout(c.ctx, dialer.Timeout)
+	defer cancel()
+	var conn net.Conn
+	if proxyType == "socks5" {
+		var credentials *proxy.Auth
+		if auth != nil {
+			credentials = &proxy.Auth{User: auth.Username, Password: auth.Passwd}
+		}
+		p, err := proxy.SOCKS5("tcp", proxyAddress, credentials, &dialer)
+		if err != nil {
+			return nil, err
+		}
+		conn, err = p.(proxy.ContextDialer).DialContext(ctx, "tcp", destination)
+		if err != nil {
+			return nil, err
+		}
+		if deadline, ok := ctx.Deadline(); ok {
+			_ = conn.SetDeadline(deadline)
+		}
+	} else {
+		address := destination
+		if proxyAddress != "" {
+			address = proxyAddress
+		}
+		conn, err = dialer.DialContext(ctx, "tcp", address)
+		if err != nil {
+			return nil, err
+		}
+		if deadline, ok := ctx.Deadline(); ok {
+			_ = conn.SetDeadline(deadline)
+		}
+		if proxyAddress != "" {
+			conn, err = androidProxyConnect(ctx, conn, destination, proxyAddress, proxyType, auth)
+			if err != nil {
+				conn.Close()
+				return nil, err
+			}
+		}
+	}
+	// 成功後保留 TLS 與 WebSocket 的既有順序。
+	current := conn
+	if protocol == "wss" {
+		current = tls.Client(current, tlsConfig)
+		_, current, err = netpkg.DialHookWebsocket("wss", tlsConfig.ServerName)(ctx, current, destination)
+	} else {
+		if protocol == "websocket" {
+			_, current, err = netpkg.DialHookWebsocket("websocket", "")(ctx, current, destination)
+		}
+		if err == nil {
+			_, current, err = netpkg.DialHookCustomTLSHeadByte(tlsConfig != nil, lo.FromPtr(c.cfg.Transport.TLS.DisableCustomTLSFirstByte))(ctx, current, destination)
+		}
+		if err == nil && tlsConfig != nil {
+			current = tls.Client(current, tlsConfig)
+		}
+	}
+	if err != nil {
+		conn.Close()
+		return nil, err
+	}
+	_ = conn.SetDeadline(time.Time{})
+	return current, nil
+}
+
+type androidPacketStream struct {
+	net.Conn
+	packet net.PacketConn
+}
+
+func (c *androidPacketStream) Close() error {
+	err := c.Conn.Close()
+	_ = c.packet.Close()
+	return err
+}
+
+func androidProxyConnect(ctx context.Context, conn net.Conn, destination, address, kind string, auth *libnet.ProxyAuth) (net.Conn, error) {
+	if kind == "https" {
+		host, _, err := net.SplitHostPort(address)
+		if err != nil {
+			return conn, err
+		}
+		tlsConn := tls.Client(conn, &tls.Config{ServerName: host})
+		if err := tlsConn.HandshakeContext(ctx); err != nil {
+			return conn, err
+		}
+		conn = tlsConn
+	} else if kind != "http" && kind != "ntlm" {
+		return conn, fmt.Errorf("unsupported Android network proxy type: %s", kind)
+	}
+	request, err := http.NewRequestWithContext(ctx, "CONNECT", "http://"+destination, nil)
+	if err != nil {
+		return conn, err
+	}
+	if auth != nil {
+		if kind == "ntlm" {
+			message, err := ntlmssp.NewNegotiateMessage("", "")
+			if err != nil {
+				return conn, err
+			}
+			request.Header.Set("Proxy-Authorization", "Negotiate "+base64.StdEncoding.EncodeToString(message))
+		} else {
+			request.SetBasicAuth(auth.Username, auth.Passwd)
+			request.Header.Set("Proxy-Authorization", request.Header.Get("Authorization"))
+			request.Header.Del("Authorization")
+		}
+	}
+	reader := bufio.NewReader(conn)
+	if err := request.Write(conn); err != nil {
+		return conn, err
+	}
+	response, err := http.ReadResponse(reader, request)
+	if err != nil {
+		return conn, err
+	}
+	if response.StatusCode == http.StatusProxyAuthRequired && kind == "ntlm" && auth != nil {
+		challenge := response.Header.Get("Proxy-Authenticate")
+		_, _ = io.Copy(io.Discard, response.Body)
+		response.Body.Close()
+		if !strings.HasPrefix(challenge, "Negotiate ") {
+			return conn, fmt.Errorf("invalid NTLM proxy challenge")
+		}
+		message, err := base64.StdEncoding.DecodeString(strings.TrimPrefix(challenge, "Negotiate "))
+		if err != nil {
+			return conn, err
+		}
+		message, err = ntlmssp.NewAuthenticateMessage(message, auth.Username, auth.Passwd, nil)
+		if err != nil {
+			return conn, err
+		}
+		request.Header.Set("Proxy-Authorization", "Negotiate "+base64.StdEncoding.EncodeToString(message))
+		if err := request.Write(conn); err != nil {
+			return conn, err
+		}
+		response, err = http.ReadResponse(reader, request)
+		if err != nil {
+			return conn, err
+		}
+	}
+	response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		return conn, fmt.Errorf("proxy CONNECT rejected: status %d", response.StatusCode)
+	}
+	// CONNECT 回應可能與第一批資料合併，不能丟棄讀取器已緩衝的資料。
+	if reader.Buffered() != 0 {
+		return &androidBufferedConn{Conn: conn, reader: reader}, nil
+	}
+	return conn, nil
+}
+
+type androidBufferedConn struct {
+	net.Conn
+	reader *bufio.Reader
+}
+
+func (c *androidBufferedConn) Read(p []byte) (int, error) { return c.reader.Read(p) }
