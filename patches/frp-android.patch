@@ -0,0 +1,35 @@
+//go:build android
+
+package main
+
+import (
+	"fmt"
+	"os"
+	"syscall"
+	"time"
+
+	"github.com/fatedier/frp/pkg/util/androidnet"
+)
+
+func init() {
+	// 版本查詢也執行原生綁定，供 App 啟動前預檢。
+	if err := androidnet.Initialize(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(78)
+	}
+	// 獨立 session 的程序群組 ID 等於 frpc PID，讓 App 可清理驗證命令的子程序。
+	if _, err := syscall.Setsid(); err != nil {
+		os.Exit(1)
+	}
+	parentPID := os.Getppid()
+	go func() {
+		for {
+			time.Sleep(250 * time.Millisecond)
+			// Go goroutine 可能切換執行緒，改以程序父 PID 避免綁定 thread 的死亡訊號。
+			if parentPID <= 1 || os.Getppid() != parentPID {
+				_ = syscall.Kill(-os.Getpid(), syscall.SIGKILL)
+				os.Exit(1)
+			}
+		}
+	}()
+}
