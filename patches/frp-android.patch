@@ -0,0 +1,31 @@
+//go:build android
+
+package sub
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+)
+
+func applyAndroidRuntimeConfig(cfg *v1.ClientCommonConfig) error {
+	portText := os.Getenv("XRAYDROID_FRP_ADMIN_PORT")
+	if portText == "" {
+		return nil
+	}
+	port, err := strconv.Atoi(portText)
+	user := os.Getenv("XRAYDROID_FRP_ADMIN_USER")
+	password := os.Getenv("XRAYDROID_FRP_ADMIN_PASSWORD")
+	if err != nil || port < 1 || port > 65535 || user == "" || password == "" {
+		return fmt.Errorf("invalid Android frpc admin settings")
+	}
+	// App 管理狀態 API 與程序重連；完整代理、訪客與傳輸設定保持原樣。
+	cfg.WebServer = v1.WebServerConfig{Addr: "127.0.0.1", Port: port, User: user, Password: password}
+	cfg.Log.To = "/dev/null"
+	cfg.Log.Level = "error"
+	reconnect := false
+	cfg.LoginFailExit = &reconnect
+	return nil
+}
