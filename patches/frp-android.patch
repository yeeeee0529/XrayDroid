@@ -0,0 +1,126 @@
+package client
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+	netpkg "github.com/fatedier/frp/pkg/util/net"
+	libnet "github.com/fatedier/golib/net"
+)
+
+func TestAndroidHTTPProxyPreservesBufferedTunnelData(t *testing.T) {
+	for _, status := range []int{http.StatusOK, http.StatusForbidden} {
+		t.Run(fmt.Sprint(status), func(t *testing.T) {
+			client, server := net.Pipe()
+			defer client.Close()
+			defer server.Close()
+			_ = client.SetDeadline(time.Now().Add(3 * time.Second))
+			_ = server.SetDeadline(time.Now().Add(3 * time.Second))
+			done := make(chan error, 1)
+			go func() {
+				req, err := http.ReadRequest(bufio.NewReader(server))
+				if err != nil {
+					done <- err
+					return
+				}
+				if req.Method != "CONNECT" || req.Host != "example.test:7000" || req.Header.Get("Proxy-Authorization") != "Basic Zml4dHVyZTpzZWNyZXQ=" {
+					done <- fmt.Errorf("unexpected CONNECT request")
+					return
+				}
+				_, err = fmt.Fprintf(server, "HTTP/1.1 %d %s\r\nContent-Length: 0\r\n\r\npayload", status, http.StatusText(status))
+				done <- err
+			}()
+			conn, err := androidProxyConnect(context.Background(), client, "example.test:7000", "127.0.0.1:7000", "http", &libnet.ProxyAuth{Username: "fixture", Passwd: "secret"})
+			if status != http.StatusOK {
+				if err == nil {
+					t.Fatal("proxy rejection ignored")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			buf := make([]byte, len("payload"))
+			if _, err := io.ReadFull(conn, buf); err != nil {
+				t.Fatal(err)
+			}
+			if string(buf) != "payload" {
+				t.Fatalf("tunnel data lost: %q", buf)
+			}
+			if err := <-done; err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+func TestAndroidConnectorTCPAndKCPRoundTrip(t *testing.T) {
+	for _, protocol := range []string{"tcp", "kcp"} {
+		t.Run(protocol, func(t *testing.T) {
+			var listener net.Listener
+			var err error
+			if protocol == "tcp" {
+				listener, err = net.Listen("tcp", "127.0.0.1:0")
+			} else {
+				listener, err = netpkg.ListenKcp("127.0.0.1:0")
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer listener.Close()
+			done := make(chan error, 1)
+			finished := make(chan struct{})
+			defer close(finished)
+			go func() {
+				conn, err := listener.Accept()
+				if err != nil {
+					done <- err
+					return
+				}
+				defer conn.Close()
+				_ = conn.SetDeadline(time.Now().Add(3 * time.Second))
+				payload := make([]byte, 4)
+				if _, err := io.ReadFull(conn, payload); err != nil {
+					done <- err
+					return
+				}
+				_, err = conn.Write(payload)
+				done <- err
+				<-finished
+			}()
+			host, port, _ := net.SplitHostPort(listener.Addr().String())
+			cfg := &v1.ClientCommonConfig{ServerAddr: host}
+			fmt.Sscan(port, &cfg.ServerPort)
+			cfg.Transport.Protocol = protocol
+			cfg.Transport.DialServerTimeout = 3
+			connector := &defaultConnectorImpl{ctx: context.Background(), cfg: cfg}
+			conn, err := connector.androidConnect(nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conn.Close()
+			_ = conn.SetDeadline(time.Now().Add(3 * time.Second))
+			if _, err := io.Copy(conn, strings.NewReader("ping")); err != nil {
+				t.Fatal(err)
+			}
+			payload := make([]byte, 4)
+			if _, err := io.ReadFull(conn, payload); err != nil {
+				t.Fatal(err)
+			}
+			if string(payload) != "ping" {
+				t.Fatalf("unexpected echo %q", payload)
+			}
+			if err := <-done; err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
diff --git a/client/app_status.go b/client/app_status.go
new file mode 100644
index 0000000..a4ea756
--- /dev/null
+++ b/client/app_status.go
@@ -0,0 +1,132 @@
+package client
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"io"
+	"net"
+	"syscall"
+
+	httppkg "github.com/fatedier/frp/pkg/util/http"
+)
+
+// 僅輸出固定分類，不把伺服器回應、權杖或原始錯誤傳給 App。
+type appLoginError struct {
+	code string
+	err  error
+}
+
+func (e appLoginError) Error() string { return e.err.Error() }
+func (e appLoginError) Unwrap() error { return e.err }
+
+type appConnectionStatus struct {
+	State         string `json:"state"`
+	Error         string `json:"error"`
+	Attempts      int    `json:"attempts"`
+	EverConnected bool   `json:"-"`
+}
+
+func (svr *Service) currentConnectionStatus() appConnectionStatus {
+	if status := svr.connectionStatus.Load(); status != nil {
+		return *status
+	}
+	return appConnectionStatus{State: "connecting"}
+}
+
+func (svr *Service) beginConnectionAttempt() {
+	status := svr.currentConnectionStatus()
+	status.Attempts++
+	if status.EverConnected {
+		status.State = "reconnecting"
+	}
+	svr.connectionStatus.Store(&status)
+}
+
+func (svr *Service) failConnectionAttempt(err error) {
+	status := svr.currentConnectionStatus()
+	status.State = "retrying"
+	if status.EverConnected {
+		status.State = "reconnecting"
+	}
+	status.Error = appConnectionError(err)
+	svr.connectionStatus.Store(&status)
+}
+
+func (svr *Service) completeConnectionAttempt() {
+	status := svr.currentConnectionStatus()
+	status.State, status.Error, status.EverConnected = "connected", "", true
+	svr.connectionStatus.Store(&status)
+}
+
+func appConnectionError(err error) string {
+	var login appLoginError
+	var dns *net.DNSError
+	var cert *tls.CertificateVerificationError
+	var unknownCA x509.UnknownAuthorityError
+	var hostname x509.HostnameError
+	var invalidCert x509.CertificateInvalidError
+	var record tls.RecordHeaderError
+	var network net.Error
+	switch {
+	case errors.As(err, &login):
+		return login.code
+	case errors.As(err, &dns):
+		return "dns"
+	case errors.As(err, &cert), errors.As(err, &unknownCA), errors.As(err, &hostname), errors.As(err, &invalidCert), errors.As(err, &record):
+		return "tls"
+	case errors.Is(err, syscall.ECONNREFUSED):
+		return "refused"
+	case errors.As(err, &network) && network.Timeout():
+		return "timeout"
+	case errors.Is(err, syscall.ENETUNREACH), errors.Is(err, syscall.EHOSTUNREACH):
+		return "unreachable"
+	case errors.Is(err, io.EOF), errors.Is(err, io.ErrUnexpectedEOF):
+		// 伺服器在回應登入前關閉連線。tcpMux 與伺服器設定不一致時，兩端
+		// 的訊息框架永遠對不上，伺服器真正的原因不會送到用戶端。
+		return "closed"
+	default:
+		return "connection"
+	}
+}
+
+func (svr *Service) appStatus(_ *httppkg.Context) (any, error) {
+	// 與控制物件替換共用鎖，關閉的舊控制連線不再回報已連線。
+	svr.ctlMu.RLock()
+	defer svr.ctlMu.RUnlock()
+	connection := svr.currentConnectionStatus()
+	if connection.State == "connected" {
+		if svr.ctl == nil {
+			connection.State = "reconnecting"
+		} else {
+			select {
+			case <-svr.ctl.Done():
+				connection.State = "reconnecting"
+			default:
+			}
+		}
+	}
+	type proxyStatus struct {
+		Name          string `json:"name"`
+		Type          string `json:"type"`
+		Status        string `json:"status"`
+		RemoteAddress string `json:"remote_addr"`
+	}
+	proxies := make([]proxyStatus, 0)
+	if connection.State == "connected" && svr.ctl != nil {
+		for _, status := range svr.ctl.pm.GetAllProxyStatus() {
+			remoteAddress := ""
+			if status.Err == "" {
+				remoteAddress = status.RemoteAddr
+				if status.Type == "tcp" || status.Type == "udp" {
+					remoteAddress = svr.common.ServerAddr + remoteAddress
+				}
+			}
+			proxies = append(proxies, proxyStatus{status.Name, status.Type, status.Phase, remoteAddress})
+		}
+	}
+	return struct {
+		Connection appConnectionStatus `json:"connection"`
+		Proxies    []proxyStatus       `json:"proxies"`
+	}{connection, proxies}, nil
+}
